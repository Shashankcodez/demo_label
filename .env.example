# Frontend API Base URL (leave blank to auto-detect localhost or LAN IP)
VITE_API_BASE_URL=

# Groq Vision AI Configuration (Backend)
GROQ_API_KEY=
AI_ENABLED=true
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=qwen/qwen3.6-27b
AI_MAX_COMPLETION_TOKENS=2500
AI_REASONING_EFFORT=none
AI_TEMPERATURE=0.2
