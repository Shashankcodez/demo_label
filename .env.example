# ===================================================================
# LabelCheck Environment Configuration
# ===================================================================

# Frontend API Base URL (leave blank to auto-detect localhost or LAN IP)
VITE_API_BASE_URL=

# Vision AI Configuration (Backend)
# Primary: Google Gemini Flash Vision
GEMINI_API_KEY=
AI_ENABLED=true
AI_PROVIDER=gemini
AI_BASE_URL=https://generativelanguage.googleapis.com
AI_MODEL=gemini-3.6-flash

# Fallback: Groq Vision
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.6-27b

AI_MAX_COMPLETION_TOKENS=4000
AI_REASONING_EFFORT=low
AI_THINKING_BUDGET=1024
AI_TEMPERATURE=0.1
